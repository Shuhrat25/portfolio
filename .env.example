# Copy to .env.local and fill in. Never commit real values.

# Gemini API key (chat + Yui's voice). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini prebuilt voice for Yui (default: Leda). Re-run `npm run voice -- --force` after changing it.
GEMINI_TTS_VOICE=

# Optional: order form delivery to Telegram. Create a bot with @BotFather, then put your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
