# Copy to .env.local and fill in. Never commit real values.

# Gemini API key (chat + Yui's voice). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini prebuilt voice for Yui (default: Leda). Re-run `npm run voice -- --force` after changing it.
GEMINI_TTS_VOICE=

# Optional: order form delivery to Telegram. Create a bot with @BotFather, then put your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for /api/report, the weekly Telegram digest of what visitors asked Yui (sent every Monday
# 09:00 Tashkent by the cron in vercel.json, through the bot above). Any long random string, e.g.
# `openssl rand -hex 32`; Vercel sends it to the cron by itself. Without it no report is sent
# (in development `/api/report?dry=1` still shows the text).
CRON_SECRET=
